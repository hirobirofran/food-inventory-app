# =====================================================================
# Vercel デプロイ時の運用ルール
# =====================================================================
# このファイル内のすべての変数を Vercel の Environment Variables に投入
# する際、Type は必ず「Secret」を選ぶ（NEXT_PUBLIC_* は除く）。
# Secret で保存した値は、保存後に誰も読めない保管になる（旧 UI の
# 「Sensitive」マークに相当）。詳細は handoff/issues/i1/vercel-settings.md を参照。
# =====================================================================

# Google Sheets
GOOGLE_SPREADSHEET_ID=（スプレッドシートIDをここに）
GOOGLE_SERVICE_ACCOUNT_EMAIL=xxx@your-project.iam.gserviceaccount.com
# JSONキーの private_key フィールドの値（-----BEGIN PRIVATE KEY----- から）
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Gemini AI API
GEMINI_API_KEY=（Google AI Studio から取得したAPIキーをここに）

# 環境識別（デモ環境の場合のみ設定）
# NEXT_PUBLIC_* はクライアントに露出する公開値なので Secret 不要（Config でよい）
# NEXT_PUBLIC_APP_ENV=demo

# 認証（Google アカウントログイン。許可リストにあるアカウントだけ入れる）
AUTH_SECRET=（npx auth secret か openssl rand -base64 32 で生成）
AUTH_GOOGLE_ID=（Google Cloud の OAuth クライアント ID）
AUTH_GOOGLE_SECRET=（同クライアントシークレット）
AUTH_ALLOWED_EMAILS=（許可するメールアドレスをカンマ区切りで）
# Google アカウントに表示されるアドレスをそのまま、半角カンマ区切りで書く（大小文字は区別しない。未設定・空なら全員拒否）
# AUTH_REDIRECT_PROXY_URL=https://<デモの固定 URL>/api/auth
# デモプロジェクトの Production と Preview にだけ入れる（初回は PR #78 のマージ後）。詳細は docs/SETUP.md の 7 章 4

# デモ環境のスプレッドシート ID（scripts/seed-demo.ts 用。本番環境のアプリでは未使用）
# 本番の GOOGLE_SPREADSHEET_ID とは必ず異なる値にする
DEMO_SHEET_ID=（デモ用スプレッドシートID）
