# =====================================================================
# `npm run seed:demo` 用のローカル設定の例。
# Vercel に入れる値と Type は docs/SETUP.md の 2-6 と 3-3 の表を見る。
# =====================================================================

# Google Sheets
GOOGLE_SPREADSHEET_ID=（スプレッドシートIDをここに）
GOOGLE_SERVICE_ACCOUNT_EMAIL=xxx@your-project.iam.gserviceaccount.com
# JSONキーの private_key フィールドの値（-----BEGIN PRIVATE KEY----- から）
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# デモ環境のスプレッドシート ID（scripts/seed-demo.ts 用。本番環境のアプリでは未使用）
# 本番の GOOGLE_SPREADSHEET_ID とは必ず異なる値にする
DEMO_SHEET_ID=（デモ用スプレッドシートID）

# infra/bootstrap/bootstrap.sh 用（docs/SETUP.md の 6 章）
# 環境変数で渡してもよい。値の意味は 6-2 の表を見る
GCP_PROJECT_ID=<GCP_PROJECT_ID>
GITHUB_REPO=<オーナー>/<リポジトリ名>
TF_STATE_BUCKET=<state 用バケットの名前>
LOG_BUCKET=<ログ用バケットの名前>
APP_SA_EMAIL=<アプリの SA のメールアドレス>
VERCEL_TEAM_SLUG=<Vercel のチームの slug>
VERCEL_PROD_PROJECT=<本番プロジェクトの名前>
VERCEL_DEMO_PROJECT=<デモプロジェクトの名前>
OWNER_EMAIL=<自分の Google アカウント>

