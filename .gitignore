# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# incident response work space (non-public notes, checklists, scratch)
/_incident/

# Claude Code のサブエージェント用ワークツリー
.claude/worktrees/
# Claude Code の個人用の設定（.claude/settings.json はコミットする）
.claude/settings.local.json

# Terraform（infra/terraform）。.terraform.lock.hcl はコミットする
.terraform/
*.tfstate
*.tfstate.*
tfplan
# 手元で試すときの変数のファイル（プロジェクト ID などの識別子が入る）と、落ちたときのログ
*.tfvars
*.tfvars.json
crash.log
